---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import CvEmployer from '../components/cv/CvEmployer.astro';
import CvItem from '../components/cv/CvItem.astro';
import CvSection from '../components/cv/CvSection.astro';
import SkillGroup from '../components/cv/SkillGroup.astro';
import { GITHUB_URL, LINKEDIN_URL, SITE_AUTHOR, SITE_ROLE } from '../consts';
import { EXTERNAL_POSTS } from '../data/external-posts';

const skills = [
	{ title: 'Languages', skills: ['Python', 'Java', 'TypeScript', 'JavaScript', 'SQL'] },
	{ title: 'Frameworks / Libraries', skills: ['Django', 'FastAPI', 'Spring Boot', 'React.js'] },
	{
		title: 'AI / ML',
		skills: [
			'Agentic AI',
			'AI Infrastructure',
			'RAG',
			'Amazon SageMaker',
			'OpenAI',
			'Amazon Bedrock',
			'Amazon Bedrock Guardrails',
			'Google Gemini',
			'Self-hosted LLMs',
		],
	},
	{ title: 'Infrastructure', skills: ['AWS', 'Docker', 'Kubernetes', 'Terraform', 'Airflow', 'GitLab'] },
	{ title: 'Databases', skills: ['PostgreSQL', 'MySQL', 'MongoDB', 'Redis', 'Vertica'] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`CV — ${SITE_AUTHOR}`} description={`Curriculum vitae for ${SITE_AUTHOR}`} />
	</head>
	<body class="bg-slate-50 print:bg-white">
		<Header />
		<main
			class="max-w-[800px] mx-auto px-6 py-12 sm:py-16 print:max-w-none print:p-0 print:text-[11pt] print:[&_a]:text-inherit print:[&_a]:no-underline"
		>
			<!-- CV header -->
			<div class="flex flex-wrap items-start justify-between gap-6 border-b-2 border-slate-900 pb-8 mb-10 print:border-black">
				<div>
					<h1 class="text-4xl font-bold text-slate-900 mb-1">{SITE_AUTHOR}</h1>
					<p class="text-lg font-semibold text-blue-600 mb-3">{SITE_ROLE}</p>
					<div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-500">
						{LINKEDIN_URL && (
							<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-600 hover:underline">
								LinkedIn
							</a>
						)}
						{GITHUB_URL && (
							<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-blue-600 hover:underline">
								GitHub
							</a>
						)}
						<span>London, United Kingdom</span>
					</div>
				</div>
				<button
					class="print:hidden shrink-0 inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-transparent px-4 py-2 text-sm font-semibold text-slate-900 transition-colors duration-150 hover:border-slate-400 hover:bg-white cursor-pointer"
					onclick="window.print()"
				>
					<svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
						<path fill="currentColor" d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1M5 1a1 1 0 0 0-1 1v1H1.5a1.5 1.5 0 0 0-1.5 1.5v8A1.5 1.5 0 0 0 1.5 14H3v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1h1.5a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11V2a1 1 0 0 0-1-1zm3 11H4v-2h8v2H8zm0-5H4V5h8v2H8zM3 3V2h10v1H3z"/>
					</svg>
					Print / PDF
				</button>
			</div>

			<CvSection title="Summary">
				<p class="text-slate-800 leading-relaxed m-0">
					Lead software engineer with experience across multiple industries and countries, working as both an individual contributor and engineering team manager.
					Specialises in building large-scale applications and cloud infrastructure.
					Currently working at NatWest Group in London, focused on building and launching large-scale GenAI solutions into production.
				</p>
			</CvSection>

			<CvSection title="Experience">
				<CvEmployer name="NatWest Group" tenure="Sep 2021 – Present · Full-time · London">
					<CvItem heading="h4" title="Lead Software Engineer — Applied AI" date="May 2024 – Present">
						<li>Lead the engineering effort of a new application using GenAI to analyse and provide recommendations for marketing communications, ensuring alignment with regulatory guidelines and NatWest's tone of voice.</li>
						<li>Led the implementation of a RAG system for NatWest's public-facing GenAI chatbot, now available to millions of customers.</li>
						<li>Delivered a GenAI solution that automates customer onboarding checks, now in production use by the onboarding team.</li>
						<li>Currently building foundational AI services to support delivery of AI solutions across NatWest.</li>
						<li>Founding member of the Python language guild and <a href="https://nwg.ai" target="_blank" rel="noopener noreferrer">public engineering blog</a> committee member.</li>
					</CvItem>

					<CvItem
						heading="h4"
						title="Senior Software Engineer — Applied AI"
						date="Dec 2022 – May 2024"
						note="Certification achieved: Certified Kubernetes Application Developer (CKAD)"
					>
						<li>Led the engineering effort to add Generative AI via a RAG architecture to NatWest's colleague chatbot Ask Archie, now scaled across the whole organisation. Co-authored <a href={EXTERNAL_POSTS[0].url} target="_blank" rel="noopener noreferrer">From RAG to Riches</a> on the NatWest Engineering Blog on this topic.</li>
						<li>Technical lead for a GenAI guardrails microservice, now deployed in production.</li>
						<li>Developed and deployed LLM APIs on SageMaker for use by client applications.</li>
						<li>Built training and inferencing ML pipelines on SageMaker, orchestrated by Airflow (MWAA).</li>
						<li>Worked with central engineering teams to scale Python across the organisation: standardised CI/CD templates, package hosting, and templated projects.</li>
					</CvItem>

					<CvItem
						heading="h4"
						title="Senior Software Engineer — ML Engineering / MLOps Platform"
						date="Sep 2021 – Nov 2022"
						note="Certification achieved: AWS Solutions Architect Associate"
					>
						<li>Built NatWest's Kepler platform — a greenfield data science and ML platform on AWS enabling teams to build and deploy models at scale, with infrastructure deployed via Terraform and CloudFormation. Co-authored an <a href={EXTERNAL_POSTS[1].url} target="_blank" rel="noopener noreferrer">AWS Machine Learning Blog post</a> about this work.</li>
						<li>Platform services: SageMaker, S3, Lambda, API Gateway, Service Catalog, EC2, ECR, CodePipeline, CodeBuild, MWAA and more.</li>
						<li>Built an internal Python package abstracting common SageMaker functionality, now used by all projects on the platform.</li>
						<li>Built an internal web application for running Kaggle-style ML competitions across the organisation.</li>
					</CvItem>
				</CvEmployer>

				<CvEmployer name="KAYAK" tenure="Nov 2015 – Sep 2021">
					<CvItem heading="h4" title="Engineering Team Lead" date="Oct 2019 – Sep 2021 · Berlin/London">
						<li>Led development of two large internal applications: KAYAK's Performance Marketing platform and in-house Business Intelligence platform.</li>
						<li>Managed a team of four software engineers, owning the technical roadmap, product backlog, development sprints and project planning.</li>
						<li>Worked closely with Product Management, Marketing Leadership, Data Science and other Engineering Managers to shape product strategy.</li>
					</CvItem>

					<CvItem heading="h4" title="Senior Software Engineer" date="Jul 2018 – Oct 2019 · Berlin">
						<li>Led the expansion of KAYAK's Performance Marketing ad-bidding engine to support eight different marketing platforms, replacing off-the-shelf and agency solutions with significant cost savings.</li>
						<li>Led a large re-architecture of the ad-bidding engine, encompassing algorithm lifecycle management, versioning and containerisation via Docker.</li>
						<li>Worked on building out KAYAK's data analytics/BI application for use by external partners.</li>
					</CvItem>

					<CvItem heading="h4" title="Software Engineer" date="Nov 2015 – Jun 2018 · Berlin">
						<li>Technical lead of KAYAK's automated ad-bidding system, responsible for hundreds of millions of dollars of marketing spend per year.</li>
						<li>Developer on a new in-house Business Intelligence tool, now used by thousands of users.</li>
						<li>Open source contributor to <a href="https://github.com/kayak/fireant" target="_blank" rel="noopener noreferrer">Fireant</a> (data visualisation) and <a href="https://github.com/kayak/pypika" target="_blank" rel="noopener noreferrer">PyPika</a> (SQL query builder).</li>
					</CvItem>
				</CvEmployer>

				<CvEmployer name="Nomura" tenure="Sep 2013 – Nov 2015 · London">
					<CvItem heading="h4" title="Technology Analyst / Senior Infrastructure Engineer">
						<li>Hadoop SME — engineered MapR for production deployment, held training courses, and led installation, benchmarking and destructive testing for a POC.</li>
						<li>Developed automation APIs in Python (Flask) and Java, including self-service workflows to remediate monitoring alerts without human intervention.</li>
						<li>Built a self-service internal-cloud portal for automated provisioning of MySQL and TIBCO EMS infrastructure.</li>
						<li>Developed Spark jobs for data transformation and led large-scale data archival from MSSQL to Hadoop (Hive, Spark, Drill).</li>
						<li>Built Splunk dashboards for data visualisation.</li>
					</CvItem>
				</CvEmployer>

				<CvEmployer name="Nomura" sub="Industrial Placement" tenure="Jun 2011 – Jun 2012 · London">
					<CvItem heading="h4" title="Technology Analyst">
						<li>Oracle DBA rotation: developed Oracle 10g/11g skills, provided user support, and built a PHP web tool for viewing database statistics on Nomura's structured equity derivatives trading platform.</li>
						<li>Web Technology rotation: contributed to a global IE8 deployment project, managed Splunk monitoring and JIRA analysis, and coordinated DR scheduling for Web Services.</li>
						<li>Collaborated regularly with colleagues across London, Japan, India and the US.</li>
					</CvItem>
				</CvEmployer>
			</CvSection>

			<CvSection title="Education">
				<CvItem
					title="Computing and Management (BSc Hons) — First Class Honours"
					org="Loughborough University · Including Diploma in Professional Studies"
					date="2009 – 2013"
				/>
			</CvSection>

			<CvSection title="Certifications">
				<div class="space-y-6">
					<CvItem title="Certified Kubernetes Application Developer (CKAD)" org="Cloud Native Computing Foundation" />
					<CvItem title="AWS Solutions Architect — Associate" org="Amazon Web Services" />
				</div>
			</CvSection>

			<CvSection title="Skills">
				<p class="text-sm text-slate-500 mb-5">Below is a non-exhaustive list of technologies I have used during my various job roles.</p>
				<div class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-6">
					{skills.map((group) => <SkillGroup title={group.title} skills={group.skills} />)}
				</div>
			</CvSection>

			<CvSection title="Writing">
				<div class="space-y-6">
					{EXTERNAL_POSTS.map((post) => (
						<CvItem org={post.publication}>
							<a slot="title" href={post.url} target="_blank" rel="noopener noreferrer" class="text-slate-900 hover:text-blue-600 hover:underline">
								{post.title}
							</a>
						</CvItem>
					))}
				</div>
			</CvSection>
		</main>
		<Footer />
	</body>
</html>
