---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_ROLE } from '../consts';
import { EXTERNAL_POSTS } from '../data/external-posts';
import { PROJECTS } from '../data/projects';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_AUTHOR}`} description={`About ${SITE_AUTHOR}`} />
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<span class="section-label">About</span>
				<h1>{SITE_AUTHOR}</h1>
				<p class="subtitle">{SITE_ROLE} · London</p>
			</div>

			<div class="prose about-content">
				<p>
					Hi! I'm Mike — a lead software engineer based in London, currently working on AI/ML applications and infrastructure at NatWest Group.
				</p>

				<h2>What I do</h2>
				<p>
					My career has focused on building data and AI systems across the travel and financial services sectors.
					I began my career at Nomura in London, developing big data infrastructure,
					before moving to Berlin to spend several years engineering advertising and data visualisation systems at KAYAK.
					Since 2021 I have been at NatWest Group, first building the bank's ML platform on AWS and more recently leading
					engineering on GenAI products such as retrieval-augmented chatbots and guardrails.
					The full story is on my <a href="/cv">CV</a>.
				</p>

				<h2>Writing</h2>
				<p>
					I write occasionally about AI engineering, Python and cloud infrastructure on the <a href="/blog">blog</a>.
					I have also written or co-authored articles elsewhere:
				</p>
				<ul>
					{EXTERNAL_POSTS.map((post) => (
						<li>
							<a href={post.url} target="_blank" rel="noopener noreferrer">{post.title}</a>
							<span class="about-publication"> — {post.publication}</span>
						</li>
					))}
				</ul>

				<h2>Side projects</h2>
				<p>
					I also build small things in my own time, usually because I wanted them to exist and nobody
					else had made one:
				</p>
				<ul>
					{PROJECTS.map((project) => (
						<li>
							<a href={project.url} target="_blank" rel="noopener noreferrer">{project.domain}</a>
							<span class="about-publication"> — {project.blurb}</span>
							{project.note && <span class="about-note">{project.note}</span>}
						</li>
					))}
				</ul>

				<h2>Outside work</h2>
				<p>
					When I'm not at a keyboard, I like to play golf, explore the countryside and occasionally pick up my guitar!
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 700px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: 3em 1em;
	}

	.page-header {
		margin-bottom: 2.5em;
		padding-bottom: 2em;
		border-bottom: 1px solid var(--border);
	}

	.page-header h1 {
		font-size: 2.25em;
		margin: 0.2em 0 0.3em 0;
	}

	.subtitle {
		color: rgb(var(--gray));
		font-size: 1em;
		margin: 0;
	}

	.about-content h2 {
		font-size: 1.25em;
		margin: 2em 0 0.5em 0;
		color: rgb(var(--black));
	}

	.about-content p,
	.about-content li {
		color: rgb(var(--gray-dark));
		line-height: 1.8;
	}

	.about-content ul {
		margin: 0 0 1.25em 0;
		padding-left: 1.25em;
		list-style-type: disc;
	}

	.about-content li {
		margin-bottom: 0.5em;
	}

	.about-publication {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}

	.about-note {
		display: block;
		margin-top: 0.35em;
		padding-left: 0.75em;
		border-left: 2px solid var(--border);
		color: rgb(var(--gray));
		font-size: 0.85em;
		font-style: italic;
		line-height: 1.6;
	}
</style>
