---
interface Props {
	title?: string;
	date?: string;
	org?: string;
	note?: string;
	/** Heading level: h3 for items directly under a section, h4 for roles under an employer. */
	heading?: 'h3' | 'h4';
}

const { title, date, org, note, heading = 'h3' } = Astro.props;
const Heading = heading;
const hasBullets = Astro.slots.has('default');
---

<div class="print:break-inside-avoid">
	<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-0.5 mb-2">
		<div class="min-w-0">
			<Heading class="text-base font-bold text-slate-900 leading-snug m-0 mb-0.5">
				<slot name="title">{title}</slot>
			</Heading>
			{org && <p class="text-sm text-slate-500 m-0">{org}</p>}
		</div>
		{date && <span class="text-[0.85em] text-slate-500 whitespace-nowrap shrink-0 tabular-nums">{date}</span>}
	</div>
	{hasBullets && (
		<ul class="list-disc pl-5 mt-2 space-y-1.5 text-[0.9em] leading-relaxed text-slate-800 [&_a]:text-blue-600 [&_a:hover]:underline">
			<slot />
		</ul>
	)}
	{note && <p class="text-[0.8em] text-slate-500 leading-relaxed mt-2.5 m-0">{note}</p>}
</div>
